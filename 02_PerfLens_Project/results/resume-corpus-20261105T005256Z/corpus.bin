      int c = value2.cardinality;
      for (int k = 0; k < c; ++k) {
        final int i = (v2[k]) >>> 6;
        long bef = b[i];
        long aft = bef | (1L << v2[k]);
        b[i] = aft;
        if (USE_BRANCHLESS) {
          cardinality += (int) ((bef - aft) >>> 63);
        } else {
          if (aft != bef) {
            cardinality++;
          }
        }
      }
      return this;
    }
    int c = value2.cardinality;
    for (int k = 0; k < c; ++k) {
      char v2 = value2.content.get(k);
      final int i = (v2) >>> 6;
      long bef = b[i];
      long aft = bef | (1L << v2);
      b[i] = aft;
      if (USE_BRANCHLESS) {
        cardinality += (int) ((bef - aft) >>> 63);
      } else {
        if (aft != bef) {
          cardinality++;
        }
      }
    }
    return this;
  }

